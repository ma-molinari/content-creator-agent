# PostgreSQL connection string (required)
# Use valores locais dedicados; nunca reutilize credenciais de produção.
DATABASE_URL=postgres://local_dev_user:local_dev_password_change_me@localhost:5432/content_creator?sslmode=disable

# JWT signing secrets (required; use long random strings)
# Exemplo seguro para gerar: openssl rand -hex 32
JWT_SECRET=set-a-64-char-random-access-secret
JWT_REFRESH_SECRET=set-a-64-char-random-refresh-secret

# CORS: comma-separated list of allowed browser origins (e.g. https://app.example.com)
# Leave empty for server-to-server / same-origin only.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Refresh cookie: set to false for local HTTP testing (default true = Secure flag on cookie)
COOKIE_SECURE=false

# Server port
PORT=8080

# Amazon S3 (required for server startup — chat delete and file endpoints)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Nome do bucket S3 (obrigatório para subir a API). Crie o bucket na AWS ou use um existente.
AWS_S3_BUCKET=

# Python worker (async slide generation). Go API POSTs jobs to WORKER_URL/jobs.
WORKER_URL=http://localhost:8000
# Shared secret: sent as X-Worker-API-Key on worker dispatch and on POST /internal/jobs/:id/complete
# Deve ser igual em apps/worker/.env ao rodar docker compose.
WORKER_API_KEY=set-a-long-random-shared-worker-key

# Design reference images on profile: max count and max file size in bytes (default 5MB)
PROFILE_REF_MAX_COUNT=8
PROFILE_REF_MAX_BYTES=5242880

# OpenAI: nightly chat summarization (gpt-5.4-mini). If unset, the summarization cron is not registered.
OPENAI_API_KEY=
# Cron expression in UTC for summarization (default: 02:00 daily). Example for tests: */5 * * * *
SUMMARIZE_CRON="0 2 * * *"

# Jobs stuck in processing: periodic cleanup (UTC). Empty STUCK_JOB_CRON disables the task.
# Use a conservative STUCK_JOB_PROCESSING_MINUTES (default 45) so slow LLM runs are not marked failed.
STUCK_JOB_CRON="*/10 * * * *"
STUCK_JOB_PROCESSING_MINUTES=45

# --- GitHub Actions (CI) ---
# Para E2E completo contra Docker Compose, configure segredos no repositório:
# OPENAI_API_KEY, AWS_REGION, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_S3_BUCKET
# (e JWT/WORKER conforme o teste). Ver docs/RUNBOOK.md e .github/workflows/ci.yml.

# Reconciliação de artefatos: manter desativada até validação operacional.
ARTIFACT_RECONCILE_ENABLED=false
ARTIFACT_RECONCILE_CRON=0 4 * * *
ARTIFACT_RECONCILE_GRACE_HOURS=24

# Fluxo estruturado permanece desativado até validação operacional.
STRUCTURED_POSTS_ENABLED=false
STRUCTURED_VISUAL_V2_ENABLED=false
STRUCTURED_VISUAL_V2_MUTATIONS_DISABLED=false
STRUCTURED_STOCK_IMAGES_ENABLED=false
# Comma-separated direct worker URLs, without a load balancer. Required for structured jobs.
STRUCTURED_WORKER_URLS=

# Optional for S3-compatible local services; leave empty/false for AWS.
AWS_S3_FORCE_PATH_STYLE=false
AWS_S3_PUBLIC_ENDPOINT=
