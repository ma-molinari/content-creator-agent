# PostgreSQL connection string (required)
DATABASE_URL=postgres://user:password@localhost:5432/content_creator?sslmode=disable

# JWT signing secrets (required; use long random strings in production)
JWT_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh

# CORS: comma-separated list of allowed browser origins (e.g. https://app.example.com)
# Leave empty for server-to-server / same-origin only.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Refresh cookie: set to false for local HTTP testing (default true = Secure flag on cookie)
COOKIE_SECURE=false

# Server port
PORT=8080

# Amazon S3 (required for server startup — chat delete and file endpoints)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# Base directory on the server where each user has instagram-audits/<user_uuid>/{AUDIT.md,BRAND.md}
PROFILE_DATA_ROOT=

# Python worker (async slide generation). Go API POSTs jobs to WORKER_URL/jobs.
WORKER_URL=http://localhost:8000
# Shared secret: sent as X-Worker-API-Key on worker dispatch and on POST /internal/jobs/:id/complete
WORKER_API_KEY=
