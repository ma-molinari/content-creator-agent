OPENAI_API_KEY=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
GO_API_URL=http://api:8080
WORKER_API_KEY=dev-worker-shared-key

# Chat model for brief + slide HTML (default gpt-5.4-mini)
OPENAI_CHAT_MODEL=gpt-5.4-mini
# Vision model for optional design reference images (default gpt-5.4-mini)
REFERENCE_VISION_MODEL=gpt-5.4-mini
# Max bytes fetched per reference image from S3 (default ~5 MiB — aligned with API reference upload cap)
REFERENCE_IMAGE_MAX_BYTES=5242880
# Require HTML source upload for every slide (default true — needed for reliable refinement)
# REQUIRE_HTML_ARTIFACT_UPLOAD=true
